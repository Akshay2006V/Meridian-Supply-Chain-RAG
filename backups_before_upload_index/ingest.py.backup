from pathlib import Path
import hashlib

import chromadb
import ollama
from pypdf import PdfReader
from langchain_text_splitters import RecursiveCharacterTextSplitter


# ------------------------------------------------------------
# Configuration
# ------------------------------------------------------------

DATA_DIR = Path("data")
CHROMA_DIR = Path("chroma_db")

COLLECTION_NAME = "meridian_supply_chain"

EMBEDDING_MODEL = "nomic-embed-text"

CHUNK_SIZE = 1000
CHUNK_OVERLAP = 150


# ------------------------------------------------------------
# ChromaDB
# ------------------------------------------------------------

client = chromadb.PersistentClient(
    path=str(CHROMA_DIR)
)

collection = client.get_or_create_collection(
    name=COLLECTION_NAME
)


# ------------------------------------------------------------
# Text splitter
# ------------------------------------------------------------

splitter = RecursiveCharacterTextSplitter(
    chunk_size=CHUNK_SIZE,
    chunk_overlap=CHUNK_OVERLAP,
    separators=[
        "\n\n",
        "\n",
        ". ",
        " ",
        ""
    ],
)


# ------------------------------------------------------------
# Helpers
# ------------------------------------------------------------

def make_id(filename: str, page: int, chunk: str) -> str:
    raw = f"{filename}|{page}|{chunk}"
    return hashlib.sha256(
        raw.encode("utf-8")
    ).hexdigest()


def embed_text(text: str):
    response = ollama.embed(
        model=EMBEDDING_MODEL,
        input=text,
    )

    return response["embeddings"][0]


def detect_document_type(filename: str) -> str:
    name = filename.lower()

    if "review" in name:
        return "performance_review"

    if "policy" in name:
        return "procurement_policy"

    return "general"


# ------------------------------------------------------------
# Process one PDF
# ------------------------------------------------------------

def process_pdf(pdf_path: Path):

    reader = PdfReader(str(pdf_path))

    documents = []
    metadatas = []
    ids = []

    document_type = detect_document_type(
        pdf_path.name
    )

    for page_number, page in enumerate(
        reader.pages,
        start=1
    ):

        text = page.extract_text() or ""
        text = text.strip()

        if not text:
            continue

        chunks = splitter.split_text(text)

        for chunk_index, chunk in enumerate(
            chunks
        ):

            chunk = chunk.strip()

            if not chunk:
                continue

            chunk_id = make_id(
                pdf_path.name,
                page_number,
                chunk
            )

            documents.append(chunk)

            metadatas.append(
                {
                    "source": pdf_path.name,
                    "page": page_number,
                    "document_type": document_type,
                    "chunk_index": chunk_index,
                }
            )

            ids.append(chunk_id)

    return documents, metadatas, ids


# ------------------------------------------------------------
# Ingest supplied PDF paths
# ------------------------------------------------------------

def ingest_paths(pdf_paths):

    total_new_chunks = 0
    files_processed = 0
    files_skipped = 0

    for pdf_path in pdf_paths:

        pdf_path = Path(pdf_path)

        if not pdf_path.exists():
            continue

        print(
            f"\nProcessing: {pdf_path.name}"
        )

        documents, metadatas, ids = process_pdf(
            pdf_path
        )

        if not documents:
            print(
                f"No text extracted from {pdf_path.name}"
            )
            files_skipped += 1
            continue

        existing = collection.get(
            ids=ids,
            include=[]
        )

        existing_ids = set(
            existing["ids"]
        )

        new_documents = []
        new_metadatas = []
        new_ids = []

        for document, metadata, doc_id in zip(
            documents,
            metadatas,
            ids
        ):

            if doc_id not in existing_ids:

                new_documents.append(document)
                new_metadatas.append(metadata)
                new_ids.append(doc_id)

        if not new_documents:

            print(
                "All chunks already exist. Skipping."
            )

            files_skipped += 1
            continue

        print(
            f"Generating embeddings for "
            f"{len(new_documents)} new chunks..."
        )

        embeddings = []

        for index, document in enumerate(
            new_documents,
            start=1
        ):

            print(
                f"Embedding {index}/{len(new_documents)}",
                end="\r"
            )

            embeddings.append(
                embed_text(document)
            )

        print()

        collection.add(
            ids=new_ids,
            documents=new_documents,
            metadatas=new_metadatas,
            embeddings=embeddings,
        )

        total_new_chunks += len(
            new_documents
        )

        files_processed += 1

        print(
            f"Added {len(new_documents)} chunks "
            f"from {pdf_path.name}"
        )

    return {
        "files_processed": files_processed,
        "files_skipped": files_skipped,
        "new_chunks": total_new_chunks,
        "total_chunks": collection.count(),
    }


# ------------------------------------------------------------
# Default ingestion from data/*.pdf
# ------------------------------------------------------------

def ingest():

    pdf_files = sorted(
        DATA_DIR.glob("*.pdf")
    )

    if not pdf_files:

        print(
            "ERROR: No PDF files found in data/"
        )

        return

    stats = ingest_paths(
        pdf_files
    )

    print()
    print("=" * 60)
    print("INGESTION COMPLETE")
    print("=" * 60)

    print(
        f"Files processed: "
        f"{stats['files_processed']}"
    )

    print(
        f"Files skipped: "
        f"{stats['files_skipped']}"
    )

    print(
        f"New chunks added: "
        f"{stats['new_chunks']}"
    )

    print(
        f"Total chunks in ChromaDB: "
        f"{stats['total_chunks']}"
    )

    print(
        f"Collection: "
        f"{COLLECTION_NAME}"
    )

    print(
        f"Database: "
        f"{CHROMA_DIR.resolve()}"
    )


# ------------------------------------------------------------
# CLI
# ------------------------------------------------------------

if __name__ == "__main__":
    ingest()