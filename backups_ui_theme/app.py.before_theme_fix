            "PDFs",
            get_indexed_documents(),
        )

    uploaded_files = st.file_uploader(
        "Add PDF documents",
        type=["pdf"],
        accept_multiple_files=True,
        help="Upload one or more PDF documents.",
    )

    if st.button(
        "📥 Index Documents",
        type="primary",
        use_container_width=True,
    ):

        if not uploaded_files:

            st.warning(
                "Upload at least one PDF first."
            )

        else:

            data_dir = Path("data")

            data_dir.mkdir(
                parents=True,
                exist_ok=True,
            )

            saved_paths = []

            with st.spinner(
                "Indexing documents..."
            ):

                try:

                    for uploaded_file in uploaded_files:

                        destination = (
                            data_dir
                            / uploaded_file.name
                        )

                        with open(
                            destination,
                            "wb",
                        ) as file:

                            file.write(
                                uploaded_file.getbuffer()
                            )

                        saved_paths.append(
                            destination
                        )

                    stats = ingest_paths(
                        saved_paths
                    )

                    st.session_state.last_index_stats = stats

                except Exception as exc:

                    st.error(
                        f"Indexing failed: {exc}"
                    )

                    st.stop()

            if stats["new_chunks"]:

                st.success(
                    f"{stats['files_checked']} file(s) checked • "
                    f"{stats['new_chunks']} new chunks • "
                    f"{stats['total_chunks']} total"
                )

            else:

                st.info(
                    f"{stats['files_checked']} file(s) checked • "
                    f"No new chunks • "
                    f"{stats['total_chunks']} already indexed"
                )

    st.divider()

    st.subheader(
        "AI Stack"
    )

    st.caption("Qwen3 4B")
    st.caption("Nomic Embed Text")
    st.caption("ChromaDB")
    st.caption("PyPDF")
    st.caption("Streamlit")

