# ============================================================

if (
    st.session_state.messages
    and st.session_state.messages[-1]["role"] == "user"
    and not st.session_state.messages[-1].get("processed")
):

    last_user = (
        st.session_state.messages[-1]
    )

    prompt_text = last_user["content"]

    last_user["processed"] = True

    with st.chat_message(
        "user",
        avatar="👤",
    ):

        st.markdown(
            prompt_text
        )

    with st.chat_message(
        "assistant",
        avatar="📦",
    ):

        with st.spinner(
            "Searching the Meridian knowledge base..."
        ):

            try:

                answer, source_data, timing = answer_question(
                    prompt_text
                )

            except Exception as exc:

                answer = (
                    "An error occurred while processing "
                    f"your question: {exc}"
                )

                source_data = []
                timing = {}

        st.markdown(
            answer
        )

        if source_data:

            st.markdown(
                "**Sources**"
            )

            for source in source_data:

                with st.container(
                    border=True
                ):

                    st.markdown(
                        f"📄 **{source['label']}**"
                    )

                    st.caption(
                        f"{source['source']} • Page {source['page']}"
                    )

    st.session_state.messages.append(
        {
            "role": "assistant",
            "content": answer,
            "sources": source_data,
            "timing": timing,
        }
    )