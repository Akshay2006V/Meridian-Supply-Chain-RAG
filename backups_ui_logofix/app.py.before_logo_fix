# ============================================================
# QUESTION PROCESSOR
# ============================================================

def run_question(prompt):

    st.session_state.messages.append(
        {
            "role": "user",
            "content": prompt,
        }
    )

    with st.chat_message(
        "user",
        avatar="👤",
    ):

        st.markdown(
            prompt
        )

    with st.chat_message(
        "assistant",
        avatar="📦",
    ):

        with st.spinner(
            "Searching the Meridian knowledge base..."
        ):

            try:

                answer, retrieved, timing = ask(
                    prompt.strip()
                )

            except Exception as exc:

                answer = (
                    "An error occurred while processing "
                    f"your question: {exc}"
                )

                retrieved = []
                timing = {}

        st.markdown(
            answer
        )

        source_data = []

        displayed_sources = set()

        for item in retrieved:

            metadata = item["metadata"]

            source = metadata["source"]
            page = metadata["page"]

            key = (
                source,
                page,
            )

            if key in displayed_sources:
                continue

            displayed_sources.add(
                key
            )

            if "Review" in source:

                label = (
                    "Supply Chain Performance Review"
                )

            elif "Policy" in source:

                label = (
                    "Procurement Policy Handbook"
                )

            else:

                label = "Indexed PDF Document"

            source_data.append(
                {
                    "label": label,
                    "source": source,
                    "page": page,
                }
            )

        if source_data:

            st.markdown(
                "**Sources**"
            )

            for source in source_data:

                with st.container(
                    border=True
                ):

                    st.markdown(
                        f"📄 **{source['label']}**"
                    )

                    st.caption(
                        f"{source['source']} • Page {source['page']}"
                    )

    st.session_state.messages.append(
        {
            "role": "assistant",
            "content": answer,
            "sources": source_data,
            "timing": timing,
        }
    )


