</style>
"""

st.markdown(
    css,
    unsafe_allow_html=True,
)


# ============================================================
# SIDEBAR
# ============================================================

with st.sidebar:

    st.title(
        "Meridian"
    )

    st.caption(
        "Supply-chain & procurement intelligence"
    )

    st.divider()

    st.subheader(
        "Knowledge Base"
    )

    s1, s2 = st.columns(2)

    with s1:

        st.metric(
            "Chunks",
            collection.count(),
        )

    with s2:

        st.metric(
            "PDFs",
            get_indexed_documents(),
        )

    st.caption(
        "Add PDF documents"
    )

    uploaded_files = st.file_uploader(
        "Upload PDF documents",
        type=["pdf"],
        accept_multiple_files=True,
        label_visibility="collapsed",
        help="Maximum 10 MB per file.",
    )

    if st.button(
        "Index Documents",
        type="primary",
        use_container_width=True,
    ):

        if not uploaded_files:

            st.warning(
                "Upload at least one PDF first."
            )

        else:

            data_dir = Path("data")

            data_dir.mkdir(
                parents=True,
                exist_ok=True,
            )

            saved_paths = []

            with st.spinner(
                "Indexing documents..."
            ):

                for uploaded_file in uploaded_files:

                    destination = (
                        data_dir
                        / uploaded_file.name
                    )

                    with open(
                        destination,
                        "wb",
                    ) as file:

                        file.write(
                            uploaded_file.getbuffer()
                        )

                    saved_paths.append(
                        destination
                    )

                stats = ingest_paths(
                    saved_paths
                )

                st.session_state.last_index_stats = stats

            if stats["new_chunks"] > 0:

                st.success(
                    f"{stats['new_chunks']} new chunks added."
                )

            else:

                st.info(
                    f"No new chunks. "
                    f"{stats['total_chunks']} chunks already indexed."
                )

    st.divider()

    st.subheader(
        "AI Stack"
    )

    st.caption("Qwen3 4B")
    st.caption("Nomic Embed Text")
    st.caption("ChromaDB")
    st.caption("PyPDF")
    st.caption("Streamlit")

    st.divider()

    st.subheader(
        "Chat History"
    )

    if st.session_state.chat_history:

        for index, item in enumerate(
            reversed(
                st.session_state.chat_history
            ),
            start=1,
        ):

            title = item[:35]

            if len(item) > 35:
                title += "..."

            st.caption(
                f"{index}. {title}"
            )

    else:

        st.caption(
            "Your conversations will appear here."
        )

    if st.button(
        "New chat",
        use_container_width=True,
    ):

        start_new_chat()

        st.rerun()


# ============================================================
# HEADER
# ============================================================

header_left, header_right = st.columns(
    [12, 1],
    vertical_alignment="center",
)

with header_left:

    st.title(
        "Meridian Supply Chain AI"
    )

    st.caption(
        "A local Retrieval-Augmented Generation assistant that answers "
        "supply-chain and procurement questions using evidence from "
        "indexed Meridian Components documents."
    )

with header_right:

    with st.popover(
        "⋮",
    ):

        st.subheader(
            "Settings"
        )

        st.markdown(
            "**Appearance**"
        )

        theme_choice = st.radio(
            "Theme",
            [
                "Dark",
                "Light",
            ],
            index=(
                0
                if st.session_state.theme == "Dark"
                else 1
            ),
            label_visibility="collapsed",
        )

        if theme_choice != st.session_state.theme:

            st.session_state.theme = theme_choice

            st.rerun()

        st.divider()

        if st.button(
            "Clear conversation",
            use_container_width=True,
        ):

            start_new_chat()

            st.rerun()


st.divider()


# ============================================================
# KNOWLEDGE BASE
# ============================================================

st.subheader(
    "Knowledge Base"
)

st.caption(
    "Persistent semantic retrieval across the indexed Meridian document collection."
)

k1, k2, k3 = st.columns(3)

with k1:

    st.metric(
        "Source documents",
        get_indexed_documents(),
    )

with k2:

    st.metric(
        "Indexed chunks",
        collection.count(),
    )

with k3:

    st.metric(
        "Grounding",
        "100%",
    )


# ============================================================
# WELCOME SCREEN
# ============================================================

if not st.session_state.messages:

    st.divider()

    st.subheader(
        "What can I help you find?"
    )

    st.caption(
        "Ask a natural-language question about supplier performance, "
        "procurement policy, spend, delivery, quality or inventory."
    )

    st.write("")

    b1, b2 = st.columns(2)

    with b1:

        if st.button(
            "Highest Q1 supplier spend",
            use_container_width=True,
        ):

            st.session_state.messages.append(
                {
                    "role": "user",
                    "content": (
                        "Which supplier had the highest spend in Q1, "
                        "and what was its on-time delivery percentage?"
                    ),
                }
            )

            st.session_state.chat_title = (
                "Highest Q1 supplier spend"
            )

            st.rerun()

    with b2:

        if st.button(
            "Q1 line stoppages",
            use_container_width=True,
        ):

            st.session_state.messages.append(
                {
                    "role": "user",
                    "content": (
                        "How many line stoppages happened in Q1, "
                        "what was the total downtime, and what caused them?"
                    ),
                }
            )

            st.session_state.chat_title = (
                "Q1 line stoppages"
            )

            st.rerun()

    b3, b4 = st.columns(2)

    with b3:

        if st.button(
            "₹1.4 crore PO authority",
            use_container_width=True,
        ):

            st.session_state.messages.append(
                {
                    "role": "user",
                    "content": (
                        "What is the approval authority for a "
                        "purchase order worth ₹1.4 crore?"
                    ),
                }
            )

            st.session_state.chat_title = (
                "₹1.4 crore PO authority"
            )

            st.rerun()

    with b4:

        if st.button(
            "Safety-stock requirement",
            use_container_width=True,
        ):

            st.session_state.messages.append(
                {
                    "role": "user",
                    "content": (
                        "Microcontrollers are imported with a "
                        "46-day lead time. Using the safety-stock "
                        "policy, how many days of stock should be "
                        "held for this part?"
                    ),
                }
            )

            st.session_state.chat_title = (
                "Safety-stock requirement"
            )

            st.rerun()


# ============================================================
# RENDER CHAT HISTORY
# ============================================================

for message in st.session_state.messages:

    with st.chat_message(
        message["role"],
        avatar=(
            "👤"
            if message["role"] == "user"
            else "📦"
        ),
    ):

        st.markdown(
            message["content"]
        )

        if (
            message["role"] == "assistant"
            and message.get("sources")
        ):

            st.markdown(
                "**Sources**"
            )

            for source in message["sources"]:

                with st.container(
                    border=True
                ):

                    st.markdown(
                        f"📄 **{source['label']}**"
                    )

                    st.caption(
                        f"{source['source']} • Page {source['page']}"
                    )


# ============================================================
# CHAT INPUT
# ============================================================

prompt = st.chat_input(
    "Message Meridian Supply Chain AI..."
)


# ============================================================
# PROCESS CHAT INPUT
#
# IMPORTANT:
# No rerun loop.
# User message -> retrieval -> response -> session history
# all happen in one Streamlit execution.
# ============================================================

if prompt:

    prompt = prompt.strip()

    if prompt:

        if st.session_state.chat_title == "New conversation":

            first_words = prompt.split()

            title = " ".join(
                first_words[:6]
            )

            if len(
                first_words
            ) > 6:

                title += "..."

            st.session_state.chat_title = title

        if (
            not st.session_state.chat_history
            or st.session_state.chat_history[-1]
            != st.session_state.chat_title
        ):

            st.session_state.chat_history.append(
                st.session_state.chat_title
            )

        with st.chat_message(
            "user",
            avatar="👤",
        ):

            st.markdown(
                prompt
            )

        with st.chat_message(
            "assistant",
            avatar="📦",
        ):

            with st.spinner(
                "Searching the Meridian knowledge base..."
            ):

                try:

                    answer, sources, timing = run_rag(
                        prompt
                    )

                except Exception as exc:

                    answer = (
                        "An error occurred while processing "
                        f"your question: {exc}"
                    )

                    sources = []
                    timing = {}

            st.markdown(
                answer
            )

            if sources:

                st.markdown(
                    "**Sources**"
                )

                for source in sources:

                    with st.container(
                        border=True
                    ):

                        st.markdown(
                            f"📄 **{source['label']}**"
                        )

                        st.caption(
                            f"{source['source']} • "
                            f"Page {source['page']}"
                        )

        # Store complete conversation state.
        st.session_state.messages.append(
            {
                "role": "user",
                "content": prompt,
            }
        )

        st.session_state.messages.append(
            {
                "role": "assistant",
                "content": answer,
                "sources": sources,
                "timing": timing,
            }
        )