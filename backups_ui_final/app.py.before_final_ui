    'procurement policy, spend, delivery, quality and inventory.'
    '</div>',
    unsafe_allow_html=True,
)

question = st.text_area(
    "Your question",
    placeholder=(
        "Example: Which supplier had the highest spend in Q1, "
        "and what was its on-time delivery percentage?"
    ),
    height=105,
)

ask_col, clear_col, _ = st.columns(
    [1, 1, 4]
)

with ask_col:

    ask_button = st.button(
        "🔍 Ask Meridian",
        type="primary",
        use_container_width=True,
    )

with clear_col:

    clear_button = st.button(
        "Clear",
        use_container_width=True,
    )


if clear_button:
    st.rerun()


# ============================================================
# ANSWER + SOURCES
# ============================================================

if ask_button:

    if not question.strip():

        st.warning(
            "Please enter a question first."
        )

    else:

        with st.spinner(
            "Searching documents and generating answer..."
        ):

            try:

                answer, retrieved, timing = ask(
                    question.strip()
                )

            except Exception as exc:

                st.error(
                    f"An error occurred: {exc}"
                )

                st.stop()

        st.divider()

        st.markdown(
            '<div class="section-title">Answer</div>',
            unsafe_allow_html=True,
        )

        with st.container(
            border=True
        ):

            st.markdown(answer)


        st.markdown(
            '<div class="section-title" style="margin-top:20px;">Sources</div>',
            unsafe_allow_html=True,
        )

        displayed_sources = set()

        for item in retrieved:

            metadata = item["metadata"]

            source = metadata["source"]
            page = metadata["page"]

            source_key = (
                source,
                page,
            )

            if source_key in displayed_sources:
                continue

            displayed_sources.add(
                source_key
            )

            if "Review" in source:

                label = (
                    "Supply Chain Performance Review"
                )

            elif "Policy" in source:

                label = (
                    "Procurement Policy Handbook"
                )

            else:

                label = (
                    "Indexed PDF Document"
                )

            st.markdown(
                f"""
                <div class="source-card">
                    <div class="source-name">
                        📄 {label}
                    </div>

                    <div class="source-meta">
                        {source} &nbsp;•&nbsp; Page {page}
                    </div>
                </div>
                """,
                unsafe_allow_html=True,
            )


