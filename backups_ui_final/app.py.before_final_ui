# DOCUMENT INGESTION
# ============================================================

st.markdown(
    '<div class="section-title">📚 Add Documents</div>',
    unsafe_allow_html=True,
)

st.markdown(
    '<div class="section-caption">'
    'Upload one or more PDF files and add them to the local knowledge base.'
    '</div>',
    unsafe_allow_html=True,
)

with st.container(border=True):

    uploaded_files = st.file_uploader(
        "Upload PDF documents",
        type=["pdf"],
        accept_multiple_files=True,
        label_visibility="visible",
        help="Upload one or more PDF documents.",
    )

    index_col, status_col = st.columns(
        [1, 2]
    )

    with index_col:

        index_button = st.button(
            "📥 Index Documents",
            type="primary",
            use_container_width=True,
        )

    with status_col:

        st.caption(
            "Duplicate-safe indexing: existing chunks are not stored twice."
        )


if index_button:

    if not uploaded_files:

        st.warning(
            "Please upload at least one PDF document."
        )

    else:

        data_dir = Path("data")
        data_dir.mkdir(
            parents=True,
            exist_ok=True,
        )

        saved_paths = []

        with st.status(
            "Indexing documents...",
            expanded=True,
        ) as status:

            try:

                for uploaded_file in uploaded_files:

                    destination = (
                        data_dir / uploaded_file.name
                    )

                    with open(
                        destination,
                        "wb",
                    ) as file:

                        file.write(
                            uploaded_file.getbuffer()
                        )

                    saved_paths.append(
                        destination
                    )

                    st.write(
                        f"Saved **{uploaded_file.name}**"
                    )

                stats = ingest_paths(
                    saved_paths
                )

                st.session_state[
                    "last_index_stats"
                ] = stats

                status.update(
                    label="Indexing complete",
                    state="complete",
                    expanded=False,
                )

            except Exception as exc:

                status.update(
                    label="Indexing failed",
                    state="error",
                    expanded=True,
                )

                st.error(
                    f"Indexing failed: {exc}"
                )

                st.stop()

        if stats["new_chunks"] > 0:

            st.success(
                f"✅ {stats['files_checked']} file(s) checked • "
                f"{stats['new_chunks']} new chunks added • "
                f"{stats['total_chunks']} total chunks in ChromaDB"
            )

        else:

            st.info(
                f"ℹ️ {stats['files_checked']} file(s) checked • "
                f"0 new chunks added • "
                f"{stats['total_chunks']} chunks already indexed"
            )


