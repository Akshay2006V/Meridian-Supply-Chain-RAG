# ============================================================
# WELCOME
# ============================================================

if not st.session_state.messages:

    st.divider()

    st.markdown(
        "## What can I help you find?"
    )

    st.caption(
        "Ask a natural-language question about supplier performance, "
        "procurement policy, spend, delivery, quality or inventory."
    )

    st.write("")

    c1, c2 = st.columns(2)

    with c1:

        if st.button(
            "Highest Q1 supplier spend",
            use_container_width=True,
        ):

            add_question(
                "Which supplier had the highest spend in Q1, "
                "and what was its on-time delivery percentage?"
            )

    with c2:

        if st.button(
            "Q1 line stoppages",
            use_container_width=True,
        ):

            add_question(
                "How many line stoppages happened in Q1, "
                "what was the total downtime, and what caused them?"
            )

    c3, c4 = st.columns(2)

    with c3:

        if st.button(
            "₹1.4 crore PO authority",
            use_container_width=True,
        ):

            add_question(
                "What is the approval authority for a "
                "purchase order worth ₹1.4 crore?"
            )

    with c4:

        if st.button(
            "Safety-stock requirement",
            use_container_width=True,
        ):

            add_question(
                "Microcontrollers are imported with a "
                "46-day lead time. Using the safety-stock "
                "policy, how many days of stock should be "
                "held for this part?"
            )


# ============================================================
# EXISTING CHAT
# ============================================================

for message in st.session_state.messages:

    with st.chat_message(
        message["role"],
        avatar=(
            "👤"
            if message["role"] == "user"
            else "📦"
        ),
    ):

        st.markdown(
            message["content"]
        )

        if (
            message["role"] == "assistant"
            and message.get("sources")
        ):

            st.markdown(
                "**Sources**"
            )

            for source in message["sources"]:

                with st.container(
                    border=True
                ):

                    st.markdown(
                        f"📄 **{source['label']}**"
                    )

                    st.caption(
                        f"{source['source']} • Page {source['page']}"
                    )


# ============================================================
# CHAT INPUT
# ============================================================

prompt = st.chat_input(
    "Message Meridian Supply Chain AI..."
)

if prompt:

    st.session_state.messages.append(
        {
            "role": "user",
            "content": prompt,
        }
    )

    st.rerun()


# ============================================================
# PROCESS NEW QUESTION
# ============================================================

if (
    st.session_state.messages
    and st.session_state.messages[-1]["role"] == "user"
    and not st.session_state.messages[-1].get("processed")
):

    user_message = (
        st.session_state.messages[-1]
    )

    prompt_text = (
        user_message["content"]
    )

    user_message["processed"] = True

    with st.chat_message(
        "user",
        avatar="👤",
    ):

        st.markdown(
            prompt_text
        )

    with st.chat_message(
        "assistant",
        avatar="📦",
    ):

        with st.spinner(
            "Searching the Meridian knowledge base..."
        ):

            try:

                answer, sources, timing = answer_question(
                    prompt_text
                )

            except Exception as exc:

                answer = (
                    "An error occurred while processing "
                    f"your question: {exc}"
                )

                sources = []
                timing = {}

        st.markdown(
            answer
        )

        if sources:

            st.markdown(
                "**Sources**"
            )

            for source in sources:

                with st.container(
                    border=True
                ):

                    st.markdown(
                        f"📄 **{source['label']}**"
                    )

                    st.caption(
                        f"{source['source']} • Page {source['page']}"
                    )

    st.session_state.messages.append(
        {
            "role": "assistant",
            "content": answer,
            "sources": sources,
            "timing": timing,
        }
    )