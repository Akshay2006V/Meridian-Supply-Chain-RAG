# CHAT INPUT
# ============================================================

prompt = st.chat_input(
    "Message Meridian Supply Chain AI..."
)


# ============================================================
# HANDLE CHAT
# ============================================================

if prompt:

    st.session_state.messages.append(
        {
            "role": "user",
            "content": prompt,
        }
    )

    with st.chat_message(
        "user",
        avatar="👤",
    ):

        st.markdown(prompt)


    with st.chat_message(
        "assistant",
        avatar="📦",
    ):

        with st.spinner(
            "Searching the Meridian knowledge base..."
        ):

            try:

                answer, retrieved, timing = ask(
                    prompt.strip()
                )

            except Exception as exc:

                answer = (
                    "An error occurred while processing "
                    f"your question: {exc}"
                )

                retrieved = []
                timing = {}


        st.markdown(answer)

        source_data = []
        displayed_sources = set()

        for item in retrieved:

            metadata = item["metadata"]

            source = metadata["source"]
            page = metadata["page"]

            source_key = (
                source,
                page,
            )

            if source_key in displayed_sources:
                continue

            displayed_sources.add(
                source_key
            )

            if "Review" in source:

                label = (
                    "Supply Chain Performance Review"
                )

            elif "Policy" in source:

                label = (
                    "Procurement Policy Handbook"
                )

            else:

                label = "Indexed PDF Document"

            source_data.append(
                {
                    "label": label,
                    "source": source,
                    "page": page,
                }
            )


        if source_data:

            st.markdown(
                '<div class="sources-title">Sources</div>',
                unsafe_allow_html=True,
            )

            for source in source_data:

                st.markdown(
                    f"""
                    <div class="source-card">
                        <div class="source-name">
                            📄 {source["label"]}
                        </div>

                        <div class="source-detail">
                            {source["source"]} • Page {source["page"]}
                        </div>
                    </div>
                    """,
                    unsafe_allow_html=True,
                )


    st.session_state.messages.append(
        {
            "role": "assistant",
            "content": answer,
            "sources": source_data,
            "timing": timing,
        }
    )