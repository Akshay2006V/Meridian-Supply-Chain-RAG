)

if st.button(
    "📥 Index Documents",
    type="primary",
    use_container_width=True,
):

    if not uploaded_files:

        st.warning(
            "Upload at least one PDF first."
        )

    else:

        data_dir = Path("data")
        data_dir.mkdir(
            parents=True,
            exist_ok=True,
        )

        saved_paths = []

        with st.spinner(
            "Indexing documents..."
        ):

            try:

                for uploaded_file in uploaded_files:

                    destination = (
                        data_dir / uploaded_file.name
                    )

                    with open(
                        destination,
                        "wb",
                    ) as file:

                        file.write(
                            uploaded_file.getbuffer()
                        )

                    saved_paths.append(
                        destination
                    )

                stats = ingest_paths(
                    saved_paths
                )

                st.session_state.last_index_stats = stats

            except Exception as exc:

                st.error(
                    f"Indexing failed: {exc}"
                )

                st.stop()

        if stats["new_chunks"] > 0:

            st.success(
                f"{stats['files_checked']} file(s) checked • "
                f"{stats['new_chunks']} new chunks • "
                f"{stats['total_chunks']} total"
            )

        else:

            st.info(
                f"{stats['files_checked']} file(s) checked • "
                f"Everything already indexed • "
                f"{stats['total_chunks']} total chunks"
            )

