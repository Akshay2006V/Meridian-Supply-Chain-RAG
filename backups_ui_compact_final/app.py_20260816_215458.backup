from pathlib import Path

import streamlit as st

from ingest import ingest_paths
from rag import ask, collection


# ============================================================
# PAGE CONFIG
# ============================================================

st.set_page_config(
    page_title="Meridian Supply Chain AI",
    layout="wide",
    initial_sidebar_state="expanded",
)


# ============================================================
# SESSION STATE
# ============================================================

if "messages" not in st.session_state:
    st.session_state.messages = []

if "last_index_stats" not in st.session_state:
    st.session_state.last_index_stats = None

if "theme" not in st.session_state:
    st.session_state.theme = "Dark"


# ============================================================
# HELPERS
# ============================================================

def get_indexed_documents():

    try:

        result = collection.get(
            include=["metadatas"]
        )

        metadatas = result.get(
            "metadatas",
            []
        )

        sources = set()

        for metadata in metadatas:

            if metadata and metadata.get("source"):

                sources.add(
                    metadata["source"]
                )

        return len(sources)

    except Exception:

        return 0


def get_document_label(source):

    if "Review" in source:
        return "Supply Chain Performance Review"

    if "Policy" in source:
        return "Procurement Policy Handbook"

    return "Indexed PDF Document"


def answer_question(prompt):

    answer, retrieved, timing = ask(
        prompt.strip()
    )

    source_data = []
    displayed_sources = set()

    for item in retrieved:

        metadata = item["metadata"]

        source = metadata["source"]
        page = metadata["page"]

        key = (
            source,
            page,
        )

        if key in displayed_sources:
            continue

        displayed_sources.add(
            key
        )

        source_data.append(
            {
                "label": get_document_label(source),
                "source": source,
                "page": page,
            }
        )

    return (
        answer,
        source_data,
        timing,
    )


def queue_question(prompt):

    st.session_state.messages.append(
        {
            "role": "user",
            "content": prompt,
            "processed": False,
        }
    )

    st.rerun()


# ============================================================
# SIDEBAR
# ============================================================

with st.sidebar:

    st.title(
        "Meridian Supply Chain AI"
    )

    st.caption("Supply-chain & procurement intelligence")

    st.divider()

    # --------------------------------------------------------
    # Appearance
    # --------------------------------------------------------

    st.subheader(
        "Appearance"
    )

    selected_theme = st.radio(
        "Theme",
        [
            "Dark",
            "Light",
        ],
        index=(
            0
            if st.session_state.theme == "Dark"
            else 1
        ),
        horizontal=True,
        label_visibility="collapsed",
    )

    if selected_theme != st.session_state.theme:

        st.session_state.theme = selected_theme

        st.rerun()

    st.divider()

    # --------------------------------------------------------
    # Knowledge Base
    # --------------------------------------------------------

    st.subheader(
        "Knowledge Base"
    )

    col1, col2 = st.columns(2)

    with col1:

        st.metric(
            "Chunks",
            collection.count(),
        )

    with col2:

        st.metric(
            "PDFs",
            get_indexed_documents(),
        )

    uploaded_files = st.file_uploader(
        "Add PDF documents",
        type=["pdf"],
        accept_multiple_files=True,
        help="Upload one or more PDF documents.",
    )

    if st.button(
        "Index Documents",
        type="primary",
        use_container_width=True,
    ):

        if not uploaded_files:

            st.warning(
                "Upload at least one PDF first."
            )

        else:

            data_dir = Path("data")

            data_dir.mkdir(
                parents=True,
                exist_ok=True,
            )

            saved_paths = []

            with st.spinner(
                "Indexing documents..."
            ):

                try:

                    for uploaded_file in uploaded_files:

                        destination = (
                            data_dir
                            / uploaded_file.name
                        )

                        with open(
                            destination,
                            "wb",
                        ) as file:

                            file.write(
                                uploaded_file.getbuffer()
                            )

                        saved_paths.append(
                            destination
                        )

                    stats = ingest_paths(
                        saved_paths
                    )

                    st.session_state.last_index_stats = stats

                except Exception as exc:

                    st.error(
                        f"Indexing failed: {exc}"
                    )

                    st.stop()

            if stats["new_chunks"] > 0:

                st.success(
                    f"{stats['files_checked']} file(s) checked • "
                    f"{stats['new_chunks']} new chunks • "
                    f"{stats['total_chunks']} total"
                )

            else:

                st.info(
                    f"{stats['files_checked']} file(s) checked • "
                    f"No new chunks • "
                    f"{stats['total_chunks']} already indexed"
                )

    st.divider()

    # --------------------------------------------------------
    # AI Stack
    # --------------------------------------------------------

    st.subheader(
        "AI Stack"
    )

    st.caption("Qwen3 4B")
    st.caption("Nomic Embed Text")
    st.caption("ChromaDB")
    st.caption("PyPDF")
    st.caption("Streamlit")

    st.divider()

    # --------------------------------------------------------
    # Clear conversation
    # --------------------------------------------------------

    if st.button(
        "Clear conversation",
        use_container_width=True,
    ):

        st.session_state.messages = []

        st.rerun()

    st.caption(
        "Answers are generated only from indexed Meridian documents."
    )


