                    "processed": False,
                }
            )

            st.rerun()

    with b:

        if st.button(
            "Q1 line stoppages",
            use_container_width=True,
        ):

            st.session_state.messages.append(
                {
                    "role": "user",
                    "content": (
                        "How many line stoppages happened in Q1, "
                        "what was the total downtime, and what caused them?"
                    ),
                    "processed": False,
                }
            )

            st.rerun()

    c, d = st.columns(2)

    with c:

        if st.button(
            "₹1.4 crore PO authority",
            use_container_width=True,
        ):

            st.session_state.messages.append(
                {
                    "role": "user",
                    "content": (
                        "What is the approval authority for a "
                        "purchase order worth ₹1.4 crore?"
                    ),
                    "processed": False,
                }
            )

            st.rerun()

    with d:

        if st.button(
            "Safety-stock requirement",
            use_container_width=True,
        ):

            st.session_state.messages.append(
                {
                    "role": "user",
                    "content": (
                        "Microcontrollers are imported with a "
                        "46-day lead time. Using the safety-stock "
                        "policy, how many days of stock should be "
                        "held for this part?"
                    ),
                    "processed": False,
                }
            )

            st.rerun()


# ============================================================
# RENDER EXISTING CHAT
# ============================================================

for message in st.session_state.messages:

    with st.chat_message(
        message["role"],
        avatar=(
            "👤"
            if message["role"] == "user"
            else "📦"
        ),
    ):

        st.markdown(
            message["content"]
        )

        if (
            message["role"] == "assistant"
            and message.get("sources")
        ):

            st.markdown(
                "**Sources**"
            )

            for source in message["sources"]:

                with st.container(
                    border=True
                ):

                    st.markdown(
                        f"📄 **{source['label']}**"
                    )

                    st.caption(
                        f"{source['source']} • Page {source['page']}"
                    )


# ============================================================
# CHAT INPUT
# ============================================================

prompt = st.chat_input(
    "Message Meridian Supply Chain AI..."
)

if prompt:

    st.session_state.messages.append(
        {
            "role": "user",
            "content": prompt,
            "processed": False,
        }
    )

    st.rerun()


# ============================================================
# PROCESS UNANSWERED USER MESSAGE
# ============================================================

pending_message = None

for message in reversed(
    st.session_state.messages
):

    if (
        message["role"] == "user"
        and not message.get("processed")
    ):

        pending_message = message
        break


if pending_message is not None:

    question = pending_message["content"]

    pending_message["processed"] = True

    with st.chat_message(
        "user",
        avatar="👤",
    ):

        st.markdown(
            question
        )

    with st.chat_message(
        "assistant",
        avatar="📦",
    ):

        with st.spinner(
            "Searching the Meridian knowledge base..."
        ):

            try:

                answer, sources, timing = answer_question(
                    question
                )

            except Exception as exc:

                answer = (
                    "An error occurred while processing "
                    f"your question: {exc}"
                )

                sources = []
                timing = {}

        st.markdown(
            answer
        )

        if sources:

            st.markdown(
                "**Sources**"
            )

            for source in sources:

                with st.container(
                    border=True
                ):

                    st.markdown(
                        f"📄 **{source['label']}**"
                    )

                    st.caption(
                        f"{source['source']} • Page {source['page']}"
                    )

    st.session_state.messages.append(
        {
            "role": "assistant",
            "content": answer,
            "sources": sources,
            "timing": timing,
        }
    )