    )

    st.write("")

    a, b = st.columns(2)

    with a:

        if st.button(
            "Highest Q1 supplier spend",
            use_container_width=True,
        ):

            st.session_state.messages.append(
                {
                    "role": "user",
                    "content": (
                        "Which supplier had the highest spend in Q1, "
                        "and what was its on-time delivery percentage?"
